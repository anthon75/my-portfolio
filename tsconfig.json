{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    
    "baseUrl": ".",
    "paths": {
      "@/Components/*": ["src"],
      
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "src/Components/Navbar/Navbar.jsx", "src/app/page.jsx", "src/Components/ProjectFeatured/projectCard.jsx", "src/Components/ProjectFeatured/project.jsx", "src/Components/ProjectFeatured/ProjectFeatured.jsx", "src/Components/ContactSection/ContactSection.jsx", "src/ui/CardHeader.jsx", "src/ui/CardContent.jsx", "src/lib/utils.js", "src/Components/Hero/HeroHeading.jsx"],
  "exclude": ["node_modules"]
}
